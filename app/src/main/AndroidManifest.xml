<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        验证器（Feature.TOTP）：扫码页申请 CAMERA 与手电筒（Camera2 setTorchMode）。
        只申请 CAMERA —— 不碰存储（相册走系统 GET_CONTENT）、不碰通讯录。
        required=false：没有摄像头的设备仍可手动输入密钥，不能因为权限声明被商店过滤。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <!-- 应用内更新：下载完成后拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 局域网互传：接收组播必须持有 MulticastLock（协议 §3 的 Android 特有约束） -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 局域网互传：端口常驻前台服务（dataSync 类型，targetSdk 34 要求显式声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 定位前台服务（targetSdk 34+ 必须显式声明类型权限，否则 startForeground 抛异常） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
        定位采集（Feature.LOCATION，默认关闭）：设置页开启后按运动状态自适应采样 ——
        移动时约 10 秒、静止时约 3 分钟（读系统缓存优先，必要时单次主动定位），不常驻监听。
        1 分钟心跳作为服务被系统杀掉后的兜底。
        ACCESS_BACKGROUND_LOCATION 是 Android 10+ 后台读位置的前提，缺它时后台采不到点 ——
        设置页把它作为「缺后台定位」的独立状态提示，不伪造已授权。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
        enableOnBackInvokedCallback：显式打开预测式返回体系（targetSdk 33+ 默认已进入，这里写死口径便于审阅）。
        Compose 的 BackHandler 在该体系下自动经 OnBackInvokedDispatcher 分发（后注册者优先），
        现有各屏 BackHandler 的触发条件与顺序不变；整屏覆盖层的转场与返回键统一收口在
        ui/foundation/Transitions.kt 的 AnimatedScreenOverlay。
    -->
    <!--
        地图入口（ui/maps）：Android 11+ 的包可见性。
        「在地图中查看」用 geo: / 各家 scheme 唤起**已安装**的地图 App，不引入任何 SDK。
        不声明这些包名时 queryIntentActivities / resolveActivity 一律看不到地图 App，
        功能会静默退化成「只有浏览器」——所以这里必须列出来。

        只列包名、不声明 <intent><data scheme="geo"> 通配：按包名精确可见，不会让本 App
        顺带看到任意能响应 https 的应用（那会白扩包可见性面）。
        浏览器兜底不绑包名，靠 https 的隐式 Intent 走系统选择器，因此不需要在这里声明。
    -->
    <queries>
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.tencent.map" />
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".MonitorApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/data_extraction_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:pageSizeCompat="enabled"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Monitor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Monitor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ⚠️ 这里注册的不是 com.bsfeng.monitor.service.MonitorAccessibilityService，而是它在
            com.google.android.accessibility.selecttospeak 包下的伪装子类。原因：微信对不在它白名单里的
            第三方无障碍服务隐藏整棵页面节点树（真机实测 root.childCount == 0），而白名单只比对
            服务 ID 的后半段类名、不校验包名（AutoJs6 issue #463）。详见该子类的 KDoc
            与 docs/记账/微信支付页识别调研.md。
            ⚠️ 换类名会让用户**已开启的旧无障碍服务失效**，需要在系统设置里重新开启一次。
        -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 局域网互传：HTTP 端口 53319~53328 + UDP 发现 53318 常驻（协议 §2） -->
        <service
            android:name=".transfer.service.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            定位采集前台服务（location 类型）：持续定位在 Android 上只能由前台服务承载。
            真机实测后台进程被 Standby/Doze 降频，一天漏拍 43 次 >6 分钟；
            没有它就无法把「移动 10 秒 / 静止 3 分钟」真正跑满。
        -->
        <service
            android:name=".service.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 局域网互传：下拉通知栏快捷开关（磁贴） -->
        <service
            android:name=".transfer.service.TransferTileService"
            android:exported="true"
            android:icon="@drawable/ic_transfer_tile"
            android:label="局域网互传"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- 定时保活检查 + 周期上报触发(每分钟一次) -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 定期备份：每天/每周由 AlarmManager 触发（频率「关闭」时闹钟会被取消） -->
        <receiver
            android:name=".backup.BackupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 额度后台刷新：按「每小时 / 每 3 小时 / 每 6 小时」由 AlarmManager 触发（关闭时不排闹钟） -->
        <receiver
            android:name=".quota.QuotaRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            桌面小组件（6 个）：Glance 的 receiver，**必须 exported=true** —— 桌面 launcher 跨应用广播
            APPWIDGET_UPDATE，exported=false 会让 provider 根本不被系统注册（桌面小组件列表里看不到）。
            meta-data 指向各自的 info。
            intent-filter 只留 APPWIDGET_UPDATE：多一个 action 就多一条外部可伪造广播的入口。
            不设 updatePeriodMillis：刷新全由 AlarmReceiver 的 60 秒心跳 + 记账/额度信号推送驱动，
            系统的周期刷新最小间隔是 30 分钟，留着只是一批无意义的唤醒。
        -->
        <receiver
            android:name=".widget.FinanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_finance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_finance_info" />
        </receiver>

        <receiver
            android:name=".widget.HealthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_health_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_health_info" />
        </receiver>

        <receiver
            android:name=".widget.QuotaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quota_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quota_info" />
        </receiver>

        <receiver
            android:name=".widget.AdSkipWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_adskip_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_adskip_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quickadd_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quickadd_info" />
        </receiver>

        <receiver
            android:name=".widget.TransferWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_transfer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_transfer_info" />
        </receiver>

        <!-- 应用内更新：下载的 APK 通过 FileProvider 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>

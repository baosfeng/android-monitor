<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新：下载完成后拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 局域网互传：接收组播必须持有 MulticastLock（协议 §3 的 Android 特有约束） -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 局域网互传：端口常驻前台服务（dataSync 类型，targetSdk 34 要求显式声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".MonitorApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/data_extraction_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:pageSizeCompat="enabled"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Monitor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Monitor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ⚠️ 这里注册的不是 com.bsfeng.monitor.service.MonitorAccessibilityService，而是它在
            com.google.android.accessibility.selecttospeak 包下的伪装子类。原因：微信对不在它白名单里的
            第三方无障碍服务隐藏整棵页面节点树（真机实测 root.childCount == 0），而白名单只比对
            服务 ID 的后半段类名、不校验包名（AutoJs6 issue #463）。详见该子类的 KDoc
            与 docs/记账/微信支付页识别调研.md。
            ⚠️ 换类名会让用户**已开启的旧无障碍服务失效**，需要在系统设置里重新开启一次。
        -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 局域网互传：HTTP 端口 53319~53328 + UDP 发现 53318 常驻（协议 §2） -->
        <service
            android:name=".transfer.service.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 局域网互传：下拉通知栏快捷开关（磁贴） -->
        <service
            android:name=".transfer.service.TransferTileService"
            android:exported="true"
            android:icon="@drawable/ic_transfer_tile"
            android:label="局域网互传"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- 定时保活检查 + 周期上报触发(每分钟一次) -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 定期备份：每天/每周由 AlarmManager 触发（频率「关闭」时闹钟会被取消） -->
        <receiver
            android:name=".backup.BackupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 应用内更新：下载的 APK 通过 FileProvider 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
